# Public browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets: never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Set to the canonical HTTPS origin in production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Web Push configuration (configure only when push is enabled)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Protect the push-reminder worker; use a random server-only secret.
CRON_SECRET=
